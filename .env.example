# BLAME GAME —— 环境变量模板（复制为 .env 或填到 Zeabur 服务的 Environment Variables）
# 真实值不要提交进 git。以下所有值都是占位/示例。

# ── server 必填 ──────────────────────────────────────────────
# OpenAI 兼容接口（用于 appearance 生成等）。BASE_URL 指向你的服务商端点。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 链上写操作用的私钥（Injective EVM 测试网）。合约地址已在 apps/server/chain-deploy.json 中，无需再配 ADDR_*。
# 只做只读/演示可留空——留空时 server 以只读链模式运行。
PRIVATE_KEY=0xyour_private_key_here

# ── server 可选 ──────────────────────────────────────────────
# 监听端口。Zeabur 会自动注入 PORT；本地默认 4000。
# PORT=4000

# SQLite 数据库文件路径。Docker 镜像内已设为持久卷挂载点 /app/apps/server/data/blame.db。
# BLAME_DB=/app/apps/server/data/blame.db

# 链网络与自定义 RPC（默认 testnet + 官方公共 RPC，一般不用改）。
# INJECTIVE_NETWORK=testnet
# INJECTIVE_TESTNET_RPC=https://k8s.testnet.json-rpc.injective.network/
# INJECTIVE_MAINNET_RPC=https://sentry.evm-rpc.injective.network/

# 供 agent.json 等对外链接拼接绝对地址；填 server 的公网地址。
# PUBLIC_API_BASE=https://advx.shineteens.com

# ── web 构建期（build-time）──────────────────────────────────
# 前端所有 /api、/audio、WebSocket 请求的后端根地址。
# 若 web 与 server 同域（nginx/Zeabur 网关统一到 advx.shineteens.com）可留空走相对路径；
# 若分成两个不同域名，则填 server 的公网地址。
# VITE_API_URL=https://advx.shineteens.com
