{
  "name": "blame-game",
  "version": "1.0.0",
  "private": true,
  "description": "《谁来背锅？ / BLAME GAME》 — AI Agent 原生策略竞技游戏 + Injective 可验证赛事平台",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @blame/server\" \"npm run dev -w @blame/web\"",
    "dev:server": "npm run dev -w @blame/server",
    "dev:web": "npm run dev -w @blame/web",
    "build": "npm run build -w @blame/web",
    "seed": "npm run seed -w @blame/server",
    "test:engine": "npm run test -w @blame/engine",
    "sfx": "node scripts/generate-sfx.mjs",
    "chain:deploy": "cd apps/server && node --env-file=../../.env scripts/deploy-chain.mjs",
    "chain:verify": "cd apps/server && node --env-file=../../.env scripts/finalize-chain.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.7.4",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
