{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@blame/shared": ["packages/shared/src/index.ts"],
      "@blame/engine": ["packages/engine/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "apps/web/dist"]
}
